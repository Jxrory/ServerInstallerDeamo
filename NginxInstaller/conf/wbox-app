# ============================================
# WonderBoxV2 - user-facing app
# wbox.makemoney2g.com -> docker app (127.0.0.1:8080)
# ============================================
# Cloudflare sits in front (orange-cloud), so this server only needs
# listen 80 - CF terminates TLS and origins to us over HTTP.
#
# Install via NginxInstaller/install.sh: this file lands at
# /etc/nginx/sites-available/wbox-app (symlinked into sites-enabled).

upstream wbox_app {
    server 127.0.0.1:8080;
}

# WebSocket upgrade map (shared by all locations below).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- HTTPS: app server ---
server {
    listen 443 ssl;
    server_name wbox.makemoney2g.com;

    # SSL certs
    # Self-signed or custom certs:
    ssl_certificate     /etc/ssl/certs/makemoney2g.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/makemoney2g.com/privkey.pem;

    # SPA fallback for the user app.
    location / {
        alias /usr/share/nginx/html/wbox-web/;
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        alias /usr/share/nginx/html/wbox-web/;
        try_files $uri =404;
        expires 1h;
    }

    # --- User-facing API -> app container (port 8080) ---
    location /api/v1/app/ {
        proxy_pass http://wbox_app;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # WebSocket / SSE support.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Spring Boot can take a moment on cold start; don't let CF
        # 524 us before the app has a chance to respond.
        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }

    # --- OAuth2 + login (app backend) ---
    location /oauth2/ {
        proxy_pass http://wbox_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /login/ {
        proxy_pass http://wbox_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
