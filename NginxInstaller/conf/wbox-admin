# ============================================
# WonderBoxV2 - admin backend
# wbox-admin.makemoney2g.com -> docker admin (127.0.0.1:8081)
# ============================================
# Cloudflare sits in front (orange-cloud), so this server only needs
# listen 80 - CF terminates TLS and origins to us over HTTP.
#
# Install via NginxInstaller/install.sh: this file lands at
# /etc/nginx/sites-available/wbox-admin (symlinked into sites-enabled).

# Trust the Cloudflare CIDRs so $remote_addr is the real visitor, not CF.
# Updated list: https://www.cloudflare.com/ips/
# (Re-pull periodically; stale list = X-Forwarded-For spoofing.)
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
real_ip_header CF-Connecting-IP;

upstream wbox_app {
    server 127.0.0.1:8081;
}

# WebSocket upgrade map (shared by all locations below).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name wbox-admin.makemoney2g.com;

    # SSL certs
    # Self-signed or custom certs:
    ssl_certificate     /etc/ssl/certs/makemoney2g.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/makemoney2g.com/privkey.pem;

    # --- Admin frontend (prebuilt dist under /admin) ---
    # Serve the admin SPA at /admin/* and fall back to its index.html.
    location /admin/ {
        alias /usr/share/nginx/html/admin/;
        try_files $uri $uri/ /admin/index.html;
    }
    location /assets/ {
        alias /usr/share/nginx/html/web/;
        try_files $uri =404;
        expires 1h;
    }

    # Spring Boot admin container (docker, port published to host).
    # All paths proxy straight through - the admin app handles /api/v1/admin/,
    # /actuator, and any static assets it serves.
    # --- Admin API -> admin container (port 8081) ---
    location /api/v1/admin/ {
        proxy_pass http://admin:8081;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # WebSocket / SSE support.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }
}
