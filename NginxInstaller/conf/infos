# =============================================================================
# InfluenceOS - Host nginx server block (HTTPS by default, HTTP -> 301 HTTPS)
# =============================================================================
# Place this file at /etc/nginx/conf.d/influence-os.conf (or sites-available/
# with a symlink to sites-enabled/, depending on your distro), then:
#   1. Edit DOMAIN and cert paths below
#   2. nginx -t          # validate config
#   3. systemctl reload nginx
#
# The upstream containers bind to 127.0.0.1 only (see docker-compose.prod.yml),
# so the host nginx reaches them via localhost.
# =============================================================================

# Upstreams - Docker containers bound to 127.0.0.1
upstream ios_web {
    server 127.0.0.1:3000;
}
upstream ios_server {
    server 127.0.0.1:3001;
}

# --- HTTP: redirect to HTTPS ---
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

# --- HTTPS: main server ---
server {
    listen 443 ssl;
    # http2 on;
    server_name infos.makemoney2g.com;

    # SSL certs
    # Self-signed or custom certs:
    ssl_certificate     /etc/ssl/certs/makemoney2g.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/makemoney2g.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Upload size (for import files)
    client_max_body_size 50m;

    # --- API routing ---

    # API v1 direct path (OAuth redirects, webhooks): /api/v1/* -> server
    location /api/v1/ {
        proxy_pass http://ios_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Frontend api-client calls: /api/* -> server (rewrite to /api/v1/*)
    location /api/ {
        rewrite ^/api/(.*)$ /api/v1/$1 break;
        proxy_pass http://ios_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Frontend ---

    # Next.js static assets (long cache)
    location /_next/static/ {
        proxy_pass http://ios_web;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Everything else -> Next.js frontend
    location / {
        proxy_pass http://ios_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}