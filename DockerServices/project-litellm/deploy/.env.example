# ============================================
# LiteLLM - env file
# ============================================
# Copy to .env and fill in real values.
#   cp deploy/.env.example deploy/.env
#
# This file is consumed by compose.yml via `env_file:`.
# Values are passed to the container VERBATIM - no ${VAR} interpolation
# happens here. (Interpolated values like DB host=postgres live in the
# `environment:` block of the compose file, not here.)

# --- LiteLLM database name (must be created in the shared postgres first) ---
LITELLM_DB_NAME=litellm

# --- Master key (callers must send this as Authorization: Bearer <key>) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
LITELLM_MASTER_KEY=sk-...
# Salt used to hash keys stored in the DB. Set once, keep stable.
LITELLM_SALT_KEY=...

# --- UI / admin login ---
UI_USERNAME=admin
UI_PASSWORD=...

# --- Optional: which models to load on startup ---
# MODEL=dall-e-3
