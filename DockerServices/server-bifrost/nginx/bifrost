# ============================================
# bifrost TK Agent - gateway API
# bifrost.makemoney2g.com -> bifrost (127.0.0.1:8088)
# ============================================

upstream bifrost_backend {
    server 127.0.0.1:2437;
    keepalive 32;
}

# $connection_upgrade is defined once in /etc/nginx/conf.d/websocket.conf

server {
    listen 443 ssl http2;
    server_name bifrost.makemoney2g.com;

    ssl_certificate     /etc/ssl/certs/makemoney2g.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/makemoney2g.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    access_log /var/log/nginx/bifrost_access.log;
    error_log  /var/log/nginx/bifrost_error.log;

    # bifrost gateway API + WebSocket (dashboard, streaming, events feed)
    location / {
        proxy_pass http://bifrost_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 10s;
        proxy_read_timeout    3600s;
        proxy_send_timeout    3600s;

        # Agent responses can be large (tool outputs, long reasoning)
        client_max_body_size 50m;
    }
}

# HTTP -> HTTPS redirect
server {
    listen 80;
    server_name bifrost.makemoney2g.com;
    return 301 https://$host$request_uri;
}
