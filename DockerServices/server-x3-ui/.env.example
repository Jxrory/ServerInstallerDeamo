# 面板监听端口(容器内与宿主机一致, Nginx 反代到该端口)
XUI_PANEL_PORT=2053

# Xray 节点端口(如 VLESS Reality), 在面板中创建入站时保持一致
XRAY_NODE_PORT=8443

# 订阅服务对外端口(Cloudflare 支持代理的 HTTPS 端口之一)
XUI_SUB_PORT=2096

# 第二个节点端口(如 Shadowsocks), 与面板中入站端口一致
XRAY_NODE_PORT_2=8445

# VMess AEAD 强制开关
XRAY_VMESS_AEAD_FORCED=false

# 容器内 fail2ban(防面板爆破)
XUI_ENABLE_FAIL2BAN=true
