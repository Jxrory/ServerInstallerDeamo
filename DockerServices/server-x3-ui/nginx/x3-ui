# ============================================
# 3x-ui 面板 - Xray 管理面板(公网入口)
# x3ui.makemoney2g.com -> 127.0.0.1:2053
# ============================================

upstream x3ui_backend {
    server 127.0.0.1:2053;
    keepalive 32;
}

# $connection_upgrade is defined once in /etc/nginx/conf.d/websocket.conf

server {
    listen 443 ssl http2;
    server_name x3ui.makemoney2g.com;

    # Let's Encrypt 证书(certbot certonly --nginx -d x3ui.<域名> 签发)
    # 注意: 本站为灰云直连域名, 不能用 Cloudflare Origin CA 证书(浏览器不信任)
    ssl_certificate     /etc/letsencrypt/live/x3ui.makemoney2g.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/x3ui.makemoney2g.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    access_log /var/log/nginx/x3ui_access.log;
    error_log  /var/log/nginx/x3ui_error.log;

    # 订阅/配置文件下载可能较大
    client_max_body_size 20m;

    # 隐藏 Nginx 版本
    server_tokens off;

    # 可选: VLESS/Trojan + WS 节点共用 443
    # 在面板创建入站时监听 10000、path 为 /ws, 再取消注释并放行端口
    #location /ws {
    #    proxy_pass http://127.0.0.1:10000;
    #    proxy_http_version 1.1;
    #    proxy_set_header Upgrade    $http_upgrade;
    #    proxy_set_header Connection $connection_upgrade;
    #    proxy_set_header Host       $host;
    #    proxy_read_timeout 3600s;
    #}

    location / {
        proxy_pass http://x3ui_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 10s;
        proxy_read_timeout    300s;
        proxy_send_timeout    300s;
    }
}

# HTTP -> HTTPS redirect
server {
    listen 80;
    server_name x3ui.makemoney2g.com;
    return 301 https://$host$request_uri;
}
