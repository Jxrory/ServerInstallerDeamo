# ============================================
# Hermes TK Agent - noVNC web client via CloakBrowser Manager
# hermes-sample-nvc.makemoney2g.com -> hermes-cloakbrowser (127.0.0.1:8080)
# ============================================
#
# CloakBrowser Manager serves the noVNC client at / (React SPA) and the
# VNC WebSocket at /api/profiles/{profile_id}/vnc. Both go through port 8080.

upstream cloak_browser_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    server_name cloak-browser.makemoney2g.com;

    ssl_certificate     /etc/ssl/certs/makemoney2g.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/makemoney2g.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!NULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    access_log /var/log/nginx/cloak_browser_access.log;
    error_log  /var/log/nginx/cloak_browser_error.log;

    # CloakBrowser Manager SPA + API + VNC WebSocket (all on port 8080)
    location / {
        proxy_pass http://cloak_browser_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # WebSocket support (required for VNC proxy)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 10s;
        proxy_read_timeout    3600s;
        proxy_send_timeout    3600s;
    }
}

# HTTP -> HTTPS redirect
server {
    listen 80;
    server_name cloak-browser.makemoney2g.com;
    return 301 https://$host$request_uri;
}
