# 必填: 设为运行 docker 命令的宿主机用户的 UID/GID, 否则 bind-mount 的 profile/ 目录
# 会因容器内 hermes 用户(默认 10000:10000)与宿主机用户不一致而产生权限问题。
# 查看当前用户: id -u && id -g
HERMES_UID=1000
HERMES_GID=1000

############### Hermes LLM 使用 Bifrost ###############
BIFROST_API_KEY=sk-xxxxxx

############### Hermes 开启 Api Server ###############
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_KEY=xxxxxx

############### Hermes 开启 Dashboard ###############
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=xxx
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=xxxxxx

############### tk-tpa 插件 ###############
# 插件运行所需的运行时环境变量。参见 profile/plugins/tk-tpa/README.md。
# Postgres 连接串(指向 tk_gateway 库, 需先用 db/init-pg.sql 初始化)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tk_gateway
# CloakBrowser sidecar(浏览器工具需要)
CLOAKBROWSER_URL=http://cloakbrowser-manager:8080
CLOAKBROWSER_PROFILE_ID=
CLOAKBROWSER_TOKEN=
# TikTok Partner ID
TK_PARTNER_ID=
# LLM(评分需要, 默认走 Bifrost)
LLM_BASE_URL=http://bifrost:8080/v1
LLM_API_KEY=${BIFROST_API_KEY}
TK_SCORE_MODEL=deepseek-v4-flash
