# ============================================
# WonderBoxV2 - admin backend env file
# ============================================
# Copy to admin.env and fill in real values.
#   cp deploy/admin.env.example deploy/admin.env
#
# Consumed by docker-compose.prod.yml via `env_file:`.
# Values are passed VERBATIM - no ${VAR} interpolation here.

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Redis db number (0-15; Redis default has 16 databases) ---
# admin uses db 1, app uses db 0 - keeps sessions/caches isolated.
SPRING_DATA_REDIS_DATABASE=5

# --- Frontend URL (for redirects / links from admin emails) ---
FRONTEND_URL=https://admin.example.com

# --- JVM tuning ---
JAVA_OPTS=-Xms256m -Xmx512m

JWT_SECRET=xxxxx