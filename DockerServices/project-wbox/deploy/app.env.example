# ============================================
# WonderBoxV2 - app backend env file
# ============================================
# Copy to app.env and fill in real values.
#   cp deploy/app.env.example deploy/app.env
#
# This file is consumed by docker-compose.prod.yml via `env_file:`.
# Values are passed to the container VERBATIM - no ${VAR} interpolation
# happens here. (Interpolated values like DB host=postgres live in the
# `environment:` block of the compose file, not here.)

# --- Spring profile ---
# Use 'prod' in real production (requires application-prod.yml to exist).
SPRING_PROFILES_ACTIVE=prod

# --- Redis db number (0-15; Redis default has 16 databases) ---
# app uses db 0, admin uses db 1 - keeps sessions/caches isolated even
# though both backends share one Redis instance.
SPRING_DATA_REDIS_DATABASE=6

# --- App ---
FRONTEND_URL=https://example.com

# --- Resend (email) ---
RESEND_API_KEY=re_...
RESEND_ENABLED=true

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=https://example.com/recharge/status
STRIPE_CANCEL_URL=https://example.com/recharge

# --- Cloudflare R2 (file storage) ---
R2_ACCESS_KEY=...
R2_SECRET_KEY=...
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=wonderbox
R2_PUBLIC_URL=https://cdn.example.com

# --- Shipping fee (integer cents; 500 = $5.00) ---
SHIPPING_FEE=500

# --- JVM tuning ---
JAVA_OPTS=-Xms256m -Xmx512m

JWT_SECRET=xxxxx